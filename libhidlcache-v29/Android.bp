cc_prebuilt_library_shared {
     name: "libhidlcache",
     soc_specific: true,
     strip: {
         none: true,
     },
     target: {
         android_arm64: {
             srcs: ["libhidlcache.so"],
         },
     },
     compile_multilib: "64",
     check_elf_files: false,
 }
